# Preferred: website-origin requests through the fixed Next.js rewrite.
NEXT_PUBLIC_CUSTOMER_API_URL=/
# Origin only, without /api/app. Set to the URL supplied by the backend team.
CUSTOMER_API_ORIGIN=
# Alternatively set NEXT_PUBLIC_CUSTOMER_API_URL to the backend HTTPS origin
# for direct browser calls; this requires CORS and compatible cookie hosting.
# Optional CDN origin for relative API image paths.
NEXT_PUBLIC_CUSTOMER_IMAGE_ORIGIN=
# Enable ONLY after backend confirms bundled product IDs match its active catalog.
NEXT_PUBLIC_PRODUCT_CHECKOUT_ENABLED=false
